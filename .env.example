# =============================================================================
# AICTE Approval Workflow Automation Platform (SIH 2026 - Problem SIH26262)
# Team StrataX - Environment Configuration Template (.env.example)
# Note: Do not commit actual API keys or secrets to version control.
# =============================================================================

# Server & Networking
PORT=5100
NODE_ENV=development
CLIENT_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000

# Authentication & Security
JWT_SECRET=aicte_sovereign_jwt_secret_dev_key_2026_stratax
JWT_EXPIRES_IN=24h

# PostgreSQL & PostGIS Database (Primary Persistence)
DATABASE_URL=postgresql://aicte_user:aicte_password@localhost:5432/aicte_db?schema=public

# Redis & BullMQ (Background Delayed Jobs & SLA Escalation Monitoring)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Google Gemini API (APH Assistant RAG Embeddings & LLM)
# If empty, the system automatically runs the deterministic Demo Provider Adapter.
GEMINI_API_KEY=your_gemini_api_key_here

# Twilio SMS Provider Adapter (Simulated by default if credentials absent)
TWILIO_ACCOUNT_SID=AC_dummy_account_sid_for_demo
TWILIO_AUTH_TOKEN=dummy_auth_token_for_demo
TWILIO_PHONE_NUMBER=+1234567890

# Meta WhatsApp Cloud API Adapter (Simulated by default if credentials absent)
WHATSAPP_ACCESS_TOKEN=dummy_meta_cloud_access_token
WHATSAPP_PHONE_NUMBER_ID=dummy_phone_number_id

# Nodemailer / SMTP Email Relay (Simulated by default if credentials absent)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=dummy_user
SMTP_PASS=dummy_password
SMTP_FROM="AICTE Approvals Bureau <approvals@aicte-india.org>"
